# =============================================================================
#  versions.env — แหล่งความจริงเดียวของทุกเวอร์ชันและทุกค่าเครือข่าย
# =============================================================================
#  ทุกบทในคู่มืออ้างตัวแปรจากไฟล์นี้ ห้ามเขียนเลขเวอร์ชันตรง ๆ ในบทไหนก็ตาม
#  เวลา upgrade ให้แก้ที่ไฟล์นี้ที่เดียว
#
#  วิธีใช้ — รันบรรทัดนี้ก่อนเริ่มทุก session บนทุกเครื่อง:
#      set -a && source /root/k8s/versions.env && set +a
#
#  เลขทั้งหมดตรวจสอบเมื่อ 25 ส.ค. 2026 — ก่อนเริ่ม Phase 1 ให้ตรวจซ้ำอีกครั้ง
#  แล้ว "ตรึงไว้" ตลอดโครงการ ห้ามอัปเดตกลางคัน
# =============================================================================

# ---------- Kubernetes ----------
K8S_VERSION=1.36.3
K8S_REPO_MINOR=v1.36              # ใช้ประกอบ URL ของ pkgs.k8s.io
CRICTL_VERSION=1.36.0             # เดินตาม minor ของ Kubernetes

# ---------- Container runtime ----------
# เลือก 2.2.x ไม่ใช่ 2.3.x เพราะเป็น patch line ที่นิ่งกว่า
# ถ้าจะขยับไป 2.3.x ให้ทดสอบใน lab ก่อนและแก้ที่ไฟล์นี้ที่เดียว
CONTAINERD_VERSION=2.2.7
RUNC_VERSION=1.5.1
CNI_PLUGINS_VERSION=1.9.1

# ---------- Networking ----------
CILIUM_VERSION=1.20.1
HELM_VERSION=4.2.4

# ---------- Ingress / TLS (บทที่ 07) ----------
GATEWAY_API_VERSION=1.6.1         # ⚠️ ไม่ใช่ตัวกำหนดเวอร์ชัน — chart ของ Envoy Gateway
                                  # ลง Gateway API CRD มาให้เอง (crds.enabled=true)
                                  # ค่านี้ใช้แค่ตอน kubectl delete ของเก่าออกที่บท 07 ขั้น 1
                                  # หลังติดตั้งเสร็จให้อ่านเวอร์ชันจริงมาแก้ตรงนี้ให้ตรง
ENVOY_GATEWAY_VERSION=1.9.0
CERT_MANAGER_VERSION=1.21.1

# ---------- Observability (บทที่ 09) ----------
METRICS_SERVER_CHART=3.14.0       # app version 0.9.0
KUBE_PROM_STACK_CHART=88.5.4
LOKI_VERSION=3.6.12                # app version ที่ chart 7.3.0 ลงจริง (ยืนยัน 5 ก.ย. 2026)
ALLOY_VERSION=1.19.0                # app version ที่ chart 1.12.0 ลงจริง (ยืนยัน 5 ก.ย. 2026)

# ตรึงแล้วทั้งคู่ ห้ามปล่อยให้ helm เลือกเอง
# ถ้าจะขยับเวอร์ชันในอนาคต ให้ดูของจริงก่อนด้วย
#   helm search repo grafana/loki --versions | head -3
# แล้วแก้ทั้ง _CHART และ _VERSION ให้ตรงกันเป็นคู่
LOKI_CHART="7.3.0"
ALLOY_CHART="1.12.0"

# ---------- Web UI (บทที่ 15) ----------
# Headlamp — เว็บ UI ที่กด scale / แก้ config ได้ (คนละตัวกับ Grafana)
# อยู่ใต้ org kubernetes-sigs · pod เดียว ไม่มี sub-chart
# ตรวจซ้ำก่อนติดตั้ง:  helm search repo headlamp/headlamp --versions | head -3
HEADLAMP_CHART=0.45.0

# ---------- OS / kernel (ตรึงด้วย dnf versionlock ที่บทที่ 01) ----------
OS_RELEASE="Oracle Linux 9.8"
KERNEL_UEK=6.12.0-206.104.3.3    # UEK 8U2 · ยืนยันครบ 6 เครื่อง (11 ก.ย. 2026)
#  ↑ หลังลง OS ใหม่ทั้ง 6 เครื่อง: ตัวที่ "รันอยู่" ยังเป็น 105 (master01-02) กับ 203
#    (master03, worker01-03) แต่ทุกเครื่องมี 206 ติดตั้งแล้วและ grubby --default-kernel
#    ชี้ไปที่ 206 ทั้งหมด → reboot ของ prepare-os.yml จะพาทุกเครื่องมาเลขนี้พร้อมกัน
#    playbook จึงเตือน patch level ไม่ตรงตอนเริ่ม (ปกติ) แล้ว assert ท้ายบทตรงหลัง reboot
#
#  บังคับ: สาย 6.12 และต้องเป็น uek
#     สองอย่างนี้เปลี่ยน feature set ที่ Cilium/eBPF ใช้จริง หลุดเมื่อไหร่ต้องหยุด
#     (เช่นเผลอบูต RHCK 5.14 หรือข้ามไป 6.13)
#
#  ไม่บังคับแต่ควรตรง: หางเลข (203/204/205)
#     เป็น errata ของ Oracle ส่วนใหญ่เป็น security backport ไม่กระทบ Cilium
#     playbook จะ 'เตือน' ไม่ใช่ 'หยุด' ถ้าเครื่องไหนไม่ตรงกับเลขนี้
#     เหตุผลที่ยังควรทำให้ตรง: เวลามีอาการแปลกเฉพาะ node เดียว จะได้ตัด
#     ตัวแปรนี้ทิ้งได้ทันทีแทนที่จะต้องพิสูจน์ว่าไม่เกี่ยว

# =============================================================================
#  ค่าเครือข่าย
# =============================================================================

# ---------- Control plane endpoint ----------
VIP=192.168.50.100
VIP_PORT=8443                     # HAProxy ฟังที่นี่ แล้ว forward ไป 6443
VIP_HOSTNAME=k8s-vip
CONTROL_PLANE_ENDPOINT=${VIP}:${VIP_PORT}

# ---------- Node ----------
NODE_SUBNET=192.168.50.0/24
NODE_IFACE=ens192                 # ชื่อ interface บน VMware — ยืนยันด้วย `ip -br a`

MASTER01_IP=192.168.50.101
MASTER02_IP=192.168.50.102
MASTER03_IP=192.168.50.103
WORKER01_IP=192.168.50.104
WORKER02_IP=192.168.50.105
WORKER03_IP=192.168.50.106

MASTER01_NAME=k8s-master01
MASTER02_NAME=k8s-master02
MASTER03_NAME=k8s-master03
WORKER01_NAME=k8s-worker01
WORKER02_NAME=k8s-worker02
WORKER03_NAME=k8s-worker03

# ---------- CIDR ภายใน cluster ----------
# ตั้งใจไม่ซ้ำกับ cluster เดิม (pod 10.242.0.0/16) เพื่อให้รันคู่กันได้ตอนย้าย workload
POD_CIDR=10.246.0.0/16
POD_CIDR_MASK_SIZE=24             # /24 ต่อ node → รองรับ 256 node
SVC_CIDR=10.247.0.0/16

# ---------- LoadBalancer IP pool (Cilium LB-IPAM) ----------
LB_POOL_START=192.168.50.200
LB_POOL_STOP=192.168.50.209

# ---------- keepalived ----------
# ห้ามซ้ำกับ cluster เดิมหรือ lab ที่อยู่ L2 domain เดียวกัน (ของเดิมใช้ 51)
VRRP_ROUTER_ID=60

# ---------- Registry ----------
REGISTRY_HOST=registry.myhr.co.th
# อยู่คนละวงกับ cluster — ต้องมีใน /etc/hosts ของทุก node และต้องเปิดทางใน
# NetworkPolicy ด้วย (config/security/allow-dns.yaml) ไม่งั้น pod จะ pull image ไม่ได้
# แบบเงียบ ๆ เพราะ NetworkPolicy ไม่เขียน log ตอนปฏิเสธ
REGISTRY_IP=192.168.30.207
