# =============================================================================
#  versions.env — แหล่งความจริงเดียวของทุกเวอร์ชันและทุกค่าเครือข่าย
# =============================================================================
#  ทุกบทในคู่มืออ้างตัวแปรจากไฟล์นี้ ห้ามเขียนเลขเวอร์ชันตรง ๆ ในบทไหนก็ตาม
#  เวลา upgrade ให้แก้ที่ไฟล์นี้ที่เดียว
#
#  วิธีใช้ — รันบรรทัดนี้ก่อนเริ่มทุก session บนทุกเครื่อง:
#      set -a && source /root/k8s/versions.env && set +a
#
#  เลขทั้งหมดตรวจสอบเมื่อ 25 ส.ค. 2026 — ก่อนเริ่ม Phase 1 ให้ตรวจซ้ำอีกครั้ง
#  แล้ว "ตรึงไว้" ตลอดโครงการ ห้ามอัปเดตกลางคัน
# =============================================================================

# ---------- Kubernetes ----------
K8S_VERSION=1.36.3
K8S_REPO_MINOR=v1.36              # ใช้ประกอบ URL ของ pkgs.k8s.io
CRICTL_VERSION=1.36.0             # เดินตาม minor ของ Kubernetes

# ---------- Container runtime ----------
# เลือก 2.2.x ไม่ใช่ 2.3.x เพราะเป็น patch line ที่นิ่งกว่า
# ถ้าจะขยับไป 2.3.x ให้ทดสอบใน lab ก่อนและแก้ที่ไฟล์นี้ที่เดียว
CONTAINERD_VERSION=2.2.7
RUNC_VERSION=1.5.1
CNI_PLUGINS_VERSION=1.9.1

# ---------- Networking ----------
CILIUM_VERSION=1.20.1
HELM_VERSION=4.2.4

# ---------- Ingress / TLS (บทที่ 07) ----------
GATEWAY_API_VERSION=1.6.1         # CRD ของ Gateway API — ต้องลงก่อน Envoy Gateway
ENVOY_GATEWAY_VERSION=1.9.0
CERT_MANAGER_VERSION=1.21.1

# ---------- Observability (บทที่ 09) ----------
METRICS_SERVER_CHART=3.14.0       # app version 0.9.0
KUBE_PROM_STACK_CHART=88.5.4
LOKI_VERSION=3.7.6
ALLOY_VERSION=1.19.0

# หา chart version ล่าสุดของ Loki/Alloy ตอนติดตั้งจริงด้วย:
#   helm search repo grafana/loki --versions | head -3
# แล้ว "เขียนกลับลงไฟล์นี้" ห้ามปล่อยให้ helm เลือกเอง
LOKI_CHART="<PIN_AT_INSTALL>"
ALLOY_CHART="<PIN_AT_INSTALL>"

# ---------- OS / kernel (ตรึงด้วย dnf versionlock ที่บทที่ 01) ----------
OS_RELEASE="Oracle Linux 9.8"
KERNEL_UEK=6.12.0-203.76.7.3      # UEK 8U2 — ค่า default ของ OL 9.8

# =============================================================================
#  ค่าเครือข่าย
# =============================================================================

# ---------- Control plane endpoint ----------
VIP=192.168.50.100
VIP_PORT=8443                     # HAProxy ฟังที่นี่ แล้ว forward ไป 6443
VIP_HOSTNAME=k8s-vip
CONTROL_PLANE_ENDPOINT=${VIP}:${VIP_PORT}

# ---------- Node ----------
NODE_SUBNET=192.168.50.0/24
NODE_IFACE=ens192                 # ชื่อ interface บน VMware — ยืนยันด้วย `ip -br a`

MASTER01_IP=192.168.50.101
MASTER02_IP=192.168.50.102
MASTER03_IP=192.168.50.103
WORKER01_IP=192.168.50.104
WORKER02_IP=192.168.50.105
WORKER03_IP=192.168.50.106

MASTER01_NAME=k8s-master01
MASTER02_NAME=k8s-master02
MASTER03_NAME=k8s-master03
WORKER01_NAME=k8s-worker01
WORKER02_NAME=k8s-worker02
WORKER03_NAME=k8s-worker03

# ---------- CIDR ภายใน cluster ----------
# ตั้งใจไม่ซ้ำกับ cluster เดิม (pod 10.242.0.0/16) เพื่อให้รันคู่กันได้ตอนย้าย workload
POD_CIDR=10.246.0.0/16
POD_CIDR_MASK_SIZE=24             # /24 ต่อ node → รองรับ 256 node
SVC_CIDR=10.247.0.0/16

# ---------- LoadBalancer IP pool (Cilium LB-IPAM) ----------
LB_POOL_START=192.168.50.200
LB_POOL_STOP=192.168.50.209

# ---------- keepalived ----------
# ห้ามซ้ำกับ cluster เดิมหรือ lab ที่อยู่ L2 domain เดียวกัน (ของเดิมใช้ 51)
VRRP_ROUTER_ID=60

# ---------- Registry ----------
REGISTRY_HOST=registry.myhr.co.th
